# V3 Supabase connection — TEMPLATE ONLY. Copy to `.env` (which is gitignored) and fill in
# YOUR values there. NEVER commit real secrets, and NEVER paste them into chat.
# SupabaseProjection reads these from the environment; nothing is hardcoded.

# Option A — Supabase client (service role bypasses RLS; keep it secret):
SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR-service-role-key-here

# Option B — direct PostgreSQL (e.g. for `supabase db push` / psql / a Postgres driver):
# DATABASE_URL=postgresql://postgres:YOUR-DB-PASSWORD@db.YOUR-PROJECT-ref.supabase.co:5432/postgres
