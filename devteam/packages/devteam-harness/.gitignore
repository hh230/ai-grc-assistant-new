# Harness result databases are run artifacts, never source. Scoped to this package rather than
# broadening the root ignore, so an unrelated *.db elsewhere is still surfaced by git.
*.db
*.db-journal
*.db-wal
*.db-shm

# Failure artifacts (screenshot + console + network + stack trace) from a browser sweep. Evidence
# for one run, not source — and a red run can drop dozens of PNGs.
artifacts/
artifacts-*/
