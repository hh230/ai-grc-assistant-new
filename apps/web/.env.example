# @grc/web environment configuration. Copy to .env.local (dev) or set in your secret
# manager (prod). Never commit real secrets.

# ── Auth ────────────────────────────────────────────────────────────────────
# Session signing key for the authentication layer (HS256 JWT in an httpOnly cookie).
# REQUIRED in production; must be at least 32 characters. Generate one with:
#   openssl rand -base64 48
AUTH_SECRET=

# ── AI provider (P4 analysis, P5 chat) ──────────────────────────────────────
# Provider selection: "openai" (default when OPENAI_API_KEY is set) or "local"
# (deterministic, no-egress fallback — no customer data leaves the tenant).
# AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5
OPENAI_EMBEDDING_MODEL=text-embedding-3-large
# OPENAI_BASE_URL=https://api.openai.com/v1

# ── Database ────────────────────────────────────────────────────────────────
# PostgreSQL (with the pgvector extension) — backs every repository adapter (documents,
# evidence, analyses, document chunk embeddings, conversations, policies, risks). REQUIRED.
# Run `pnpm db:migrate` after pointing this at a fresh database.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/aigrc

# ── Storage ─────────────────────────────────────────────────────────────────
# Root directory for uploaded document/evidence blobs (object storage adapter). Defaults to
# "<app>/.data". Point this at a persistent volume in production, or replace the blob-store
# adapter with S3/GCS.
# STORAGE_DIR=/var/lib/grc/data

# ── v2/apps/grc-api (Governance Discovery/Planning, Missions) ───────────────
# Base URL of the v2 grc-api FastAPI host. Defaults to http://localhost:8000 when unset —
# see v2/apps/grc-api/README.md for how to run it (Install -> Migrate -> Run).
# GRC_API_BASE_URL=http://localhost:8000
# REQUIRED for /discovery, /plan, and Mission-approval routes to authenticate against
# grc-api (ADR 0066 "Frontend integration") — must be the exact same value grc-api's own
# process has as GRC_API_SERVICE_SECRET (an HMAC signing secret, not a real credential to
# share elsewhere). Generate one with: openssl rand -hex 32
GRC_API_SERVICE_SECRET=

# TEMPORARY BOOTSTRAP UNTIL INTERNAL IDENTITY EXISTS (ADR 0067 backlog).
#
# Who may govern SECTOR KNOWLEDGE — a comma-separated list of emails. This is not domain and not
# infrastructure; it is bootstrap, and bootstrap that outlives one development phase becomes debt.
# Nothing may be built on top of it: no feature reads this list or stores what it returns.
#
# It is not a workspace role because the authority is not a tenant's to grant — a sector's questions
# are answered by every organization in that sector, so mapping it to `owner` would hand it to every
# customer account in the product.
#
# UNSET MEANS NOBODY. An unconfigured deployment has no knowledge reviewers, which is the correct
# failure — it never means everybody. Without it, /knowledge is refused for all callers.
# KNOWLEDGE_APPROVERS=knowledge@rasheedgrc.com,another@rasheedgrc.com

# ── Site URL ─────────────────────────────────────────────────────────────────
# Public origin used to resolve absolute URLs for metadata (OG image, icons).
# Defaults to http://localhost:3000 when unset — set this to the real domain in production.
# NEXT_PUBLIC_APP_URL=https://app.example.com

# ── Email (KI-P9 access onboarding — invitation emails) ─────────────────────
# Resend API key. Server-side only — never exposed to the browser (lib/email/client.ts is
# the only place this is read). Without it, sending fails gracefully: approving an access
# request still creates the invitation and shows its copyable link.
RESEND_API_KEY=
# The "From" address/display name Resend sends as, e.g. "Rasheed <noreply@rasheed.sa>".
# Must be a verified sender/domain in your Resend account.
EMAIL_FROM=

# ── Error monitoring (Sentry) ────────────────────────────────────────────────
# Server-side error capture (API errors, AI pipeline/chat failures, database errors) —
# lib/observability/logger.ts reports every logger.error() call here. Only active when
# NODE_ENV=production; unset locally by default so dev/test never reports anywhere.
SENTRY_DSN=
# Build-time source map upload (CI/Vercel prod build only; build succeeds without these,
# just without readable stack traces in Sentry).
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
