  "rules": [
    {
      "id": "r:org_structure_documented_scores_governance",
      "version": "1.0",
      "predicate": { "signal": "org_structure_state", "op": "gte", "value": "documented_unapproved" },
      "effect": { "maturity_dimension_score": { "dimension": "governance", "delta": 3 } }
    },
    {
      "id": "r:org_structure_absent_seeds_formalization",
      "version": "1.0",
      "predicate": { "signal": "org_structure_state", "op": "eq", "value": "absent" },
      "effect": {
        "plan_seed": {
          "id": "seed:formalize_org_structure",
          "pillar": "organization",
          "title_key": "plan.seed.formalize_org_structure.title",
          "rationale_key": "plan.seed.formalize_org_structure.rationale",
          "urgency": "high",
          "effort_size": "medium",
          "resolves_signal": { "signal": "org_structure_state", "value": "approved" }
        }
      }
    },
    {
      "id": "r:policy_approved_scores_policy",
      "version": "1.0",
      "predicate": { "signal": "policy_state", "op": "gte", "value": "approved" },
      "effect": { "maturity_dimension_score": { "dimension": "governance", "delta": 4 } }
    },
    {
      "id": "r:policy_weak_seeds_drafting",
      "version": "1.0",
      "predicate": { "signal": "policy_state", "op": "lte", "value": "verbal" },
      "effect": {
        "plan_seed": {
          "id": "seed:draft_foundational_policies",
          "pillar": "policies",
          "title_key": "plan.seed.draft_foundational_policies.title",
          "rationale_key": "plan.seed.draft_foundational_policies.rationale",
          "urgency": "high",
          "effort_size": "medium",
          "depends_on": ["seed:formalize_org_structure"],
          "resolves_signal": { "signal": "policy_state", "value": "approved" }
        }
      }
    },
    {
      "id": "r:risk_register_absent_seeds_establishment",
      "version": "1.0",
      "predicate": { "signal": "risk_register_state", "op": "eq", "value": "absent" },
      "effect": {
        "plan_seed": {
          "id": "seed:establish_risk_register",
          "pillar": "risk",
          "title_key": "plan.seed.establish_risk_register.title",
          "rationale_key": "plan.seed.establish_risk_register.rationale",
          "urgency": "high",
          "effort_size": "small",
          "resolves_signal": { "signal": "risk_register_state", "value": "approved" }
        }
      }
    },
    {
      "id": "r:risk_register_approved_scores_risk",
      "version": "1.0",
      "predicate": { "signal": "risk_register_state", "op": "gte", "value": "approved" },
      "effect": { "maturity_dimension_score": { "dimension": "risk", "delta": 4 } }
    },
    {
      "id": "r:internal_audit_absent_seeds_cadence",
      "version": "1.0",
      "predicate": { "signal": "internal_audit_state", "op": "eq", "value": "absent" },
      "effect": {
        "plan_seed": {
          "id": "seed:plan_internal_audit_cadence",
          "pillar": "compliance",
          "title_key": "plan.seed.plan_internal_audit_cadence.title",
          "rationale_key": "plan.seed.plan_internal_audit_cadence.rationale",
          "urgency": "low",
          "effort_size": "medium",
          "resolves_signal": { "signal": "internal_audit_state", "value": "approved" }
        }
      }
    },
    {
      "id": "r:no_compliance_officer_seeds_designation",
      "version": "1.0",
      "predicate": { "signal": "has_compliance_officer", "op": "eq", "value": false },
      "effect": {
        "plan_seed": {
          "id": "seed:designate_compliance_owner",
          "pillar": "organization",
          "title_key": "plan.seed.designate_compliance_owner.title",
          "rationale_key": "plan.seed.designate_compliance_owner.rationale",
          "urgency": "critical",
          "effort_size": "small",
          "resolves_signal": { "signal": "has_compliance_officer", "value": true }
        }
      }
    },
    {
      "id": "r:personal_data_without_policy_flags_gap",
      "version": "1.0",
      "predicate": {
        "all": [
          { "signal": "handles_personal_data", "op": "eq", "value": true },
          { "signal": "policy_state", "op": "lte", "value": "verbal" }
        ]
      },
      "effect": {
        "flags_gap": {
          "gap_id": "gap:personal_data_without_policy",
          "severity": "high",
          "rationale_key": "plan.gap.personal_data_without_policy.rationale"
        }
      }
    },
    {
      "id": "r:personal_data_seeds_review",
      "version": "1.0",
      "predicate": { "signal": "handles_personal_data", "op": "eq", "value": true },
      "effect": {
        "plan_seed": {
          "id": "seed:review_personal_data_handling",
          "pillar": "legal",
          "title_key": "plan.seed.review_personal_data_handling.title",
          "rationale_key": "plan.seed.review_personal_data_handling.rationale",
          "urgency": "medium",
          "effort_size": "medium"
        }
      }
    },
    {
      "id": "r:internal_audit_approved_scores_compliance",
      "version": "1.0",
      "predicate": { "signal": "internal_audit_state", "op": "gte", "value": "approved" },
      "effect": { "maturity_dimension_score": { "dimension": "compliance", "delta": 4 } }
    },
    {
      "id": "r:compliance_officer_scores_compliance",
      "version": "1.0",
      "predicate": { "signal": "has_compliance_officer", "op": "eq", "value": true },
      "effect": { "maturity_dimension_score": { "dimension": "compliance", "delta": 3 } }
    },
    {
      "id": "r:has_board_scores_leadership",
      "version": "1.0",
      "predicate": { "signal": "has_board", "op": "eq", "value": true },
      "effect": { "maturity_dimension_score": { "dimension": "leadership", "delta": 4 } }
    },
    {
      "id": "r:compliance_officer_scores_leadership",
      "version": "1.0",
      "predicate": { "signal": "has_compliance_officer", "op": "eq", "value": true },
      "effect": { "maturity_dimension_score": { "dimension": "leadership", "delta": 3 } }
    },
    {
      "id": "r:dedicated_execution_capacity_scores_leadership",
      "version": "1.0",
      "predicate": {
        "signal": "execution_capacity",
        "op": "in",
        "value": ["dedicated_budget", "dedicated_team_and_budget"]
      },
      "effect": { "maturity_dimension_score": { "dimension": "leadership", "delta": 3 } }
    },
    {
      "id": "r:no_board_seeds_governance_body",
      "version": "1.0",
      "predicate": { "signal": "has_board", "op": "eq", "value": false },
      "effect": {
        "plan_seed": {
          "id": "seed:establish_governance_oversight_body",
          "pillar": "governance",
          "title_key": "plan.seed.establish_governance_oversight_body.title",
          "rationale_key": "plan.seed.establish_governance_oversight_body.rationale",
          "urgency": "medium",
          "effort_size": "medium",
          "resolves_signal": { "signal": "has_board", "value": true }
        }
      }
    },
    {
      "id": "r:gov_client_without_compliance_officer_flags_gap",
      "version": "1.0",
      "predicate": {
        "all": [
          { "signal": "has_gov_clients", "op": "eq", "value": true },
          { "signal": "has_compliance_officer", "op": "eq", "value": false }
        ]
      },
      "effect": {
        "flags_gap": {
          "gap_id": "gap:gov_client_without_compliance_officer",
          "severity": "critical",
          "rationale_key": "plan.gap.gov_client_without_compliance_officer.rationale"
        }
      }
    }
  ]
}
