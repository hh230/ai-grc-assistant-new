# grc-api — every variable a deployment sets. NAMES AND SHAPES ONLY; never commit a real value.
#
# Copy to `.env` locally, or paste these keys into the host's secret manager (Railway/Render
# variables, Cloud Run secrets, ECS parameters). Secrets belong to the platform, not to a
# developer's machine and not to this repository.

# ── Required ────────────────────────────────────────────────────────────────────────────────
# The V2 core database: missions, outbox, read models, discovery sessions, governance plans.
# One managed Postgres serves both; they are separate variables only so they COULD be split.
# `DATABASE_URL` is accepted as a fallback for either, because most hosts inject that name.
MISSION_STORE_DSN=postgresql://USER:PASSWORD@HOST:5432/DATABASE
GOVERNANCE_STORE_DSN=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# The shared secret apps/web signs its service assertion with (ADR 0066 addendum). It must be
# byte-identical to the web app's GRC_API_SERVICE_SECRET or every governance request 401s.
# Comma-separated during a rotation: this side ACCEPTS every entry, the web side SIGNS with the
# first. Tokens live 60s, so an overlap need only outlast that.
GRC_API_SERVICE_SECRET=

# ── Required for the Governance Plan to actually be written ────────────────────────────────
# Without a provider the API still boots and serves everything else, but mission steps ECHO and
# the draft step produces no plan — logged as `llm_provider_unconfigured` + `execution_degraded`.
# The credential is read by the vendor's own SDK, never by this codebase.
GRC_LLM_PROVIDER=openai
# GRC_LLM_MODEL=                      # optional; each adapter has its own default
OPENAI_API_KEY=
# ANTHROPIC_API_KEY=                  # if GRC_LLM_PROVIDER=claude  (also add the [claude] extra)
# GOOGLE_API_KEY=                     # if GRC_LLM_PROVIDER=gemini  (also add the [gemini] extra)

# ── Optional ────────────────────────────────────────────────────────────────────────────────
# The pgvector database holding `knowledge_vectors`. Unset is fine: the Discovery → Plan journey
# does not read it, and `grc_api.migrate` skips its migrations rather than failing.
# RETRIEVAL_PG_DSN=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# Connection pool. Managed Postgres caps connections aggressively, so this — not CPU — is what
# falls over first under load (B3).
# DB_POOL_MIN_SIZE=1
# DB_POOL_MAX_SIZE=5
# DB_POOL_TIMEOUT=10

# Supplied by the platform on Railway/Render/Cloud Run; 8000 locally.
# PORT=8000
